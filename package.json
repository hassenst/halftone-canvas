{
  "name": "halftone-canvas",
  "version": "0.1.0",
  "description": "Framework-agnostic halftone rasterizer and canvas animator",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "keywords": [
    "halftone",
    "canvas",
    "image-processing",
    "raster",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "vitest": "^5.1.2",
    "vitest-canvas-mock": "^1.2.0"
  }
}

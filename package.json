{
  "name": "@hassenst/halftone-canvas",
  "version": "0.1.0",
  "description": "Framework-agnostic halftone rasterizer and canvas animator",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "keywords": ["halftone", "canvas", "image-processing", "raster", "typescript"],
  "license": "MIT"
}